keytool -genkeypair \
  -v \
  -keystore keystore.jks \
  -alias universal-performance \
  -keyalg RSA \
  -keysize 2048 \
  -validity 10000

base64 -w 0 keystore.jks > keystore.base64
base64 -i keystore.jks -o keystore.base64
[Convert]::ToBase64String(
    [IO.File]::ReadAllBytes("keystore.jks")
)
